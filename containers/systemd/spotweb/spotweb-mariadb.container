[Unit]
Description=MariaDB container

[Container]
Image=docker.io/library/mariadb:latest
AutoUpdate=registry
Environment=MARIADB_AUTO_UPGRADE=true
Environment=MARIADB_ROOT_HOST=%
Environment=MARIADB_DATABASE=spotweb
Environment=MARIADB_USER=user
Environment=MARIADB_PASSWORD=password
Environment=MARIADB_ROOT_PASSWORD=password
NoNewPrivileges=true
ShmSize=100m
Volume=spotweb-mariadb.volume:/var/lib/mysql:rw,Z,U
Network=spotweb.network
ExposeHostPort=3306

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
