[Unit]
Description=MariaDB container
# Started with Spotweb or the retrieve job, and stopped again once neither
# needs it.
StopWhenUnneeded=yes

[Container]
Image=docker.io/library/mariadb:latest
AutoUpdate=registry
Environment=MARIADB_AUTO_UPGRADE=true
Environment=MARIADB_ROOT_HOST=%
Environment=MARIADB_DATABASE=spotweb
Environment=MARIADB_USER=user
Environment=MARIADB_PASSWORD=password
Environment=MARIADB_ROOT_PASSWORD=password
NoNewPrivileges=true
ShmSize=100m
Volume=spotweb-mariadb.volume:/var/lib/mysql:rw,Z,U
Network=spotweb.network
ExposeHostPort=3306
# Only counts as started once it accepts connections, so Spotweb and the
# retrieve job don't connect too early.
Notify=healthy
HealthStartupCmd=healthcheck.sh --connect --innodb_initialized
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
