# FileName=spotweb
[Unit]
Description=Spotweb container
Requires=spotweb-mariadb.container
After=spotweb-mariadb.container

[Container]
Image=ghcr.io/francoism90/spotweb:latest
AutoUpdate=registry
Secret=spotweb-db-password,type=env,target=DB_PASSWORD
# FrankenPHP's Caddy state (XDG_DATA_HOME and XDG_CONFIG_HOME), such as its
# local CA, kept across restarts.
Volume=spotweb-data.volume:/data:rw,Z
Volume=spotweb-config.volume:/config:rw,Z
Network=spotweb.network
# For the Pods proxy, which reaches it by name. "lpod spotweb ondemand
# enable" publishes it on 127.0.0.1 behind a socket in a drop-in.
ExposeHostPort=8000
# Ready as soon as FrankenPHP serves a static file, so the first request
# waits for it instead of failing.
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/favicon.ico
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/favicon.ico
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=default.target
