# FileName=spotweb
[Unit]
Description=Spotweb container
Requires=spotweb-mariadb.container
After=spotweb-mariadb.container

[Container]
Image=ghcr.io/francoism90/spotweb:latest
AutoUpdate=registry
UserNS=keep-id
Volume=%h/workspace/spotweb/dbsettings.inc.php:/app/dbsettings.inc.php:rw,z
Network=spotweb.network
PublishPort=8000:8000

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
