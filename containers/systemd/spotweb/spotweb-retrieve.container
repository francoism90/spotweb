# FileName=spotweb-retrieve
[Unit]
Description=Spotweb retrieve job
Requires=spotweb-mariadb.container
After=spotweb-mariadb.container

[Container]
Image=ghcr.io/francoism90/spotweb:latest
AutoUpdate=registry
UserNS=keep-id
# The host user's IDs, since UserNS=keep-id maps them into the container.
Environment=PUID=%U
Environment=PGID=%G
Secret=spotweb-db-password,type=env,target=DB_PASSWORD
Network=spotweb.network
HealthCmd=none
Exec=php /app/retrieve.php

[Service]
# Run once per trigger of spotweb-retrieve.timer, which lpod writes from
# timers: in pods.yml. A first retrieve can take hours, so there's no start
# timeout.
Type=oneshot
TimeoutStartSec=infinity
TimeoutStopSec=30
