# FrankenPHP 1 with PHP 8.6, pinned so a new PHP release doesn't break the
# weekly build. Pass --build-arg FRANKENPHP_VERSION=... for another one.
ARG FRANKENPHP_VERSION=1-php8.6

FROM docker.io/dunglas/frankenphp:${FRANKENPHP_VERSION}

ARG UID=1000
ARG GID=1000
ARG PHP_EXTENSIONS=""

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV SERVER_ROOT=/app
ENV SERVER_NAME=:8000

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl ca-certificates gosu \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd --force -g ${GID} spotweb \
    && useradd -u ${UID} -g spotweb -d /home/spotweb -s /bin/bash -m spotweb

# Create directories and set ownership
RUN mkdir -p /app \
    && chown -R spotweb:spotweb /app /config /data

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-production ${PHP_INI_DIR}/php.ini

# Install the PHP extensions Spotweb uses that the base image lacks
RUN install-php-extensions gd gettext intl mbstring pdo_mysql zip

# Install additional PHP extensions if specified
RUN if [ -n "$PHP_EXTENSIONS" ]; then \
    install-php-extensions $PHP_EXTENSIONS; \
fi

# Custom PHP configuration
COPY containers/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Strip file capabilities from frankenphp, and install Spotweb. libcap2-bin and
# git are only needed here, so install and purge them within this layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin git \
    && setcap -r /usr/local/bin/frankenphp \
    && rm -rf /app/* \
    && git clone --depth 1 -b develop https://github.com/spotweb/spotweb.git /app \
    && chown -R spotweb:spotweb /app \
    && sed -i '/^error_reporting(2147483647);/d' /app/*.php /app/bin/*.php \
    && sed -i 's/set_time_limit(120);/set_time_limit(0);/' /app/lib/services/Retriever/*.php \
    && rm -rf /app/.git /app/.github /app/.gitignore /app/.gitattributes /app/.coveralls.yml /app/.rnd /app/.scrutinizer.yml /app/.travis.yml /app/*.md \
    && apt-get purge -y --auto-remove libcap2-bin git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Database settings, read from the environment
COPY --chown=spotweb:spotweb containers/runtimes/dbsettings.inc.php /app/dbsettings.inc.php

# Entrypoint, and the database upgrade that Pods runs after installs and updates
COPY --chmod=755 containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=755 containers/runtimes/upgrade.sh /usr/local/bin/spotweb-upgrade

# Run as root so the entrypoint can renumber the "spotweb" user to the
# runtime PUID/PGID before dropping privileges
USER root

EXPOSE 8000

# CMD is redeclared because ENTRYPOINT resets the base image's inherited one
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
